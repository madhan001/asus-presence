# asus-presence agent settings: ~/.config/asus-presence/presence.conf
# Applied live. Change them with the Presence Sensor window or
# asus-presence-ctl set KEY VALUE. Missing keys use these defaults.
[presence]
# Master switch for the agent's actions (the sensor goes to standby when off).
enabled = true
# Lock the session after being away this many seconds (10..3600).
lock = true
lock_after = 60
# Dim the built-in screen after looking away this many seconds (3..600),
# to dim_level percent of maximum brightness (5..90); restored when you look back.
dim = true
dim_after = 10
dim_level = 30
# While you are looking at the screen (and for 30 s after you look away;
# released at once when you leave):
#   keep_screen_on: stop Plasma dimming, blanking or idle-locking the screen
#                   (this also prevents sleep)
#   prevent_sleep:  stop Plasma's idle sleep only
keep_screen_on = true
prevent_sleep = true
# Keep the sensor on while locked and wake the screen when you return.
# Off by default: costs a little power while the session is locked.
wake_on_return = false
# How often the sensor reports, in Hz (0.5..10). Presence and attention must
# hold for two reports, so this sets how quickly it reacts (about 2/rate
# seconds); higher rates use more power. Applied live.
sample_rate = 2
